# ─────────────────────────────────────────────────────────────
# DAMA KITCHEN — environment variables (self-hosted, Hostinger)
#
# Local development: copy to .env.local and fill in.
# Hostinger: hPanel → Websites → (your Node.js app) → Settings / Environment
#            variables. NEVER commit real values to GitHub.
# See docs/DAMA_HOSTINGER_DEPLOYMENT_GUIDE.md for every value explained.
# ─────────────────────────────────────────────────────────────

# ── Required ──────────────────────────────────────────────────

# MySQL / MariaDB connection (hPanel → Databases → MySQL Databases).
# Format: mysql://USER:PASSWORD@HOST:3306/DATABASE
# URL-encode special characters in the password (e.g. @ → %40, # → %23).
DATABASE_URL=mysql://dama_user:CHANGE_ME@localhost:3306/dama_cms

# Public site address — used for canonical URLs, sitemap, Open Graph.
# NOTE: NEXT_PUBLIC_* values are baked in at BUILD time → set it before building.
NEXT_PUBLIC_SITE_URL=https://damakitchen.id

# Search-engine indexing. Leave unset (or anything but "true") on staging:
# robots.txt then disallows everything and every response is noindex.
# Set SITE_INDEXING=true ONLY on the production deployment. Runtime — no rebuild.
SITE_INDEXING=

# ── First admin setup / password reset ────────────────────────
# A long random value (min. 16 chars). Only needed to create the first owner
# account at /admin/setup or to reset a forgotten password. REMOVE it again
# after use (the dashboard warns while it is set). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_SETUP_TOKEN=

# ── Media storage ─────────────────────────────────────────────
# "database" (default, recommended on Hostinger Managed Node.js): uploaded files
#   are stored in MySQL → they survive every redeploy and are in DB backups.
# "filesystem": files under MEDIA_ROOT — ONLY with a persistent directory
#   OUTSIDE the deployed app folder (VPS), e.g. /home/dama/dama-media
MEDIA_STORAGE=database
MEDIA_ROOT=

# ── Scheduled backups (optional, recommended) ─────────────────
# Absolute directory outside the app where /api/backup/cron writes backups,
# a long random token the cron job sends in the "x-backup-token" header, and
# how many backup files to keep.
BACKUP_DIR=
BACKUP_CRON_TOKEN=
BACKUP_KEEP=14

# ── Analytics & verification (production only; see docs/DAMA_ANALYTICS_SETUP.md) ──
# Use GTM_ID (recommended) OR GA4_ID — GA4_ID is ignored when GTM_ID is set.
GTM_ID=
GA4_ID=
CLARITY_ID=
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# ── Optional ──────────────────────────────────────────────────
# MySQL connection pool size (keep small on shared hosting).
DATABASE_POOL_SIZE=5

# Fallback WhatsApp number used only before the database is reachable.
# The real number is edited in Admin → Pengaturan situs.
NEXT_PUBLIC_WHATSAPP_NUMBER=6281181207201

# Optional inquiry email adapter (lib/email.ts). WhatsApp remains the primary
# channel; leave blank to skip email.
INQUIRY_EMAIL_API_KEY=
INQUIRY_EMAIL_TO=

# Local testing over plain http with NODE_ENV=production only (never in prod).
# INSECURE_COOKIES=1
